<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>jenkins-bridge</artifactId>
    <groupId>com.jetbrains.teamcity.jenkinsbridge</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jenkins-bridge-server</artifactId>
  <packaging>jar</packaging>
  <properties>
    <mockito.version>5.23.0</mockito.version>
    <!-- The Java 21 profile below enables the legacy TeamCity fixture Security Manager flag. -->
    <teamcity.test.argLine></teamcity.test.argLine>
  </properties>

  <profiles>
    <profile>
      <id>teamcity-fixture-java21</id>
      <activation>
        <jdk>[21,22)</jdk>
      </activation>
      <properties>
        <!-- BaseServerTestCase still installs a Security Manager during fixture cleanup. -->
        <teamcity.test.argLine>-Djava.security.manager=allow</teamcity.test.argLine>
      </properties>
    </profile>
    <profile>
      <id>teamcity-integration-tests</id>
      <dependencies>
        <!-- The database-backed TeamCity fixture is intentionally integration-test only. -->
        <dependency>
          <groupId>org.jetbrains.teamcity</groupId>
          <artifactId>server-test-core</artifactId>
          <version>${teamcity-version}</version>
          <scope>test</scope>
        </dependency>

        <dependency>
          <groupId>org.jetbrains.teamcity</groupId>
          <artifactId>configs-impl</artifactId>
          <version>${teamcity-version}</version>
          <scope>test</scope>
        </dependency>

        <!-- The public TeamCity repository does not publish this proprietary module for the
             fixture's server version, but server-core loads its license exception during startup. -->
        <dependency>
          <groupId>org.jetbrains.teamcity</groupId>
          <artifactId>license-protected</artifactId>
          <version>${teamcity-license-version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testIncludes combine.self="override">
                <testInclude>**/*Test.java</testInclude>
                <testInclude>**/*IT.java</testInclude>
              </testIncludes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <skipITs>false</skipITs>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- This profile is an explicit TeamCity compatibility run; unit tests belong
                   to the default, lightweight Maven test path. -->
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-api</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>common-api</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-web-api</artifactId>
      <version>${teamcity-version}</version>
      <type>war</type>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-core</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- BuildTypeEx's internal secure-storage API extends the VCS workspace API. This is a
         production compile/runtime contract, not a database-fixture dependency. -->
    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-vcs-api-ex</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>common-impl</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>oauth-integration</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- server-test-core's legacy commons-httpclient otherwise wins Maven conflict resolution with
         commons-codec 1.2, which lacks Hex.encodeHexString used by current TeamCity core. -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.17.1</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.9.1</version>
    </dependency>

    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.5</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
      <scope>compile</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <!-- Integration fixture sources and their dependencies are profile-scoped. -->
          <testIncludes>
            <testInclude>**/*Test.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>${teamcity.test.argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit4</artifactId>
            <version>3.5.4</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- Integration tests also use Mockito's inline mock maker. Attach the agent
               explicitly because TeamCity's fixture JVM may not allow self-attachment. -->
          <argLine>${teamcity.test.argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
          <skipITs>true</skipITs>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
