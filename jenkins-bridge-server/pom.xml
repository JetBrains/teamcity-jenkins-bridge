<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>jenkins-bridge</artifactId>
    <groupId>com.jetbrains.teamcity.jenkinsbridge</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jenkins-bridge-server</artifactId>
  <packaging>jar</packaging>
  <properties>
    <mockito.version>5.23.0</mockito.version>
    <!-- BaseServerTestCase still installs a Security Manager during fixture cleanup. Java 21
         permits that legacy operation only when this forked-test-JVM flag is present. -->
    <teamcity.test.argLine>-Djava.security.manager=allow</teamcity.test.argLine>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-api</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>common-api</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-web-api</artifactId>
      <version>${teamcity-version}</version>
      <type>war</type>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-core</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>common-impl</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>oauth-integration</artifactId>
      <version>${teamcity-version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- tests-support is only an aggregator; server-test-core contains the database-backed fixture. -->
    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-test-core</artifactId>
      <version>${teamcity-version}</version>
      <scope>test</scope>
    </dependency>

    <!-- server-test-core's SBuildType signatures reference the VCS workspace API. -->
    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>server-vcs-api-ex</artifactId>
      <version>${teamcity-version}</version>
      <scope>test</scope>
    </dependency>

    <!-- server-test-core bootstraps the real build-type/template implementation. -->
    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>configs-impl</artifactId>
      <version>${teamcity-version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>license-protected</artifactId>
      <!-- The public 2026.3 EAP repository omits this proprietary module, but server-core still
           loads its ReleaseDateHolder interface while bootstrapping the test fixture. -->
      <version>${teamcity-license-version}</version>
      <scope>test</scope>
    </dependency>

    <!-- server-test-core's legacy commons-httpclient otherwise wins Maven conflict resolution with
         commons-codec 1.2, which lacks Hex.encodeHexString used by current TeamCity core. -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.17.1</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.9.1</version>
    </dependency>

    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.5</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
      <scope>compile</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>${teamcity.test.argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit4</artifactId>
            <version>3.5.4</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>${teamcity.test.argLine}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
