<?xml version="1.0"?>
<assembly>
  <id>plugin-assembly</id>
  <includeBaseDirectory>false</includeBaseDirectory>
  <formats>
    <format>zip</format>
  </formats>
  <files>
     <file>
         <source>target/teamcity-plugin.xml</source>
         <outputDirectory>/</outputDirectory>
     </file> 
  </files>
  <fileSets>
    <fileSet>
      <directory>../jenkins-bridge-server/src/main/resources/kotlin-dsl</directory>
      <outputDirectory>kotlin-dsl</outputDirectory>
      <includes>
        <include>*.xml</include>
      </includes>
    </fileSet>
  </fileSets>
  <moduleSets>
    <moduleSet>
       <useAllReactorProjects>true</useAllReactorProjects>
       <includes>
           <include>com.jetbrains.teamcity.jenkinsbridge:jenkins-bridge-server</include>
       </includes> 
       <binaries>
           <outputDirectory>server</outputDirectory>
           <unpack>false</unpack>
           <dependencySets>
               <dependencySet>
                    <includes>
                         <include>*</include>
                    </includes>
               </dependencySet>
           </dependencySets>
       </binaries>
    </moduleSet>
  </moduleSets>
</assembly>
